# Copy to .env.local and fill in to enable Connected mode.
# Both values are PUBLISHABLE client configuration (safe in the browser).
# Never put the service_role / secret key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
# Optional: public URL of the deployed app (used for profile share links)
VITE_PUBLIC_APP_URL=https://hard-earned.example.com
