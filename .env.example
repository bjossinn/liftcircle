# Copy to .env.local and fill in to enable Connected mode.
# Both values are PUBLISHABLE client configuration (safe in the browser).
# Never put the service_role / secret key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
# Optional: public URL of the deployed app (used for profile share links)
VITE_PUBLIC_APP_URL=https://hard-earned.example.com
# Optional feature flags (src/config/featureFlags.ts). Both default to off; set to true and rebuild to switch on.
# Turning a flag off only hides the area from navigation: no data, tables or API code is removed.
# Find a coach, coach profiles and new coaching requests:
# VITE_ENABLE_COACH_MARKETPLACE=true
# The Feed tab and the /feed list:
# VITE_ENABLE_SOCIAL_FEED=true
