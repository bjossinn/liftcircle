/**
 * Generates supabase/seed.sql (read-only shared reference catalogs) from the bundled data:
 *   src/data/exercises.ts (EXERCISES), src/data/ingredients.ts (INGREDIENTS), src/data/recipes.ts (RECIPES)
 *
 * Run:  node --experimental-strip-types scripts/gen-reference-seed.mts
 * (Node ≥ 22.6. The data files only use `import type`, which type stripping removes; a tiny
 *  resolve hook below also maps the `@/` alias and extension-less specifiers just in case.)
 *
 * The seed is idempotent (upsert + delete of rows no longer bundled), so it can be re-applied
 * with `supabase db reset` locally or pasted into the SQL editor of a hosted project.
 */
import { register } from 'node:module';
import { writeFileSync } from 'node:fs';
import { dirname, resolve } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';

const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
const srcUrl = pathToFileURL(resolve(root, 'src') + '/').href;

const hook = `
const SRC = ${JSON.stringify(srcUrl)};
export async function resolve(specifier, context, next) {
  if (specifier.startsWith('@/')) specifier = new URL(specifier.slice(2), SRC).href;
  try { return await next(specifier, context); }
  catch (e) {
    if ((specifier.startsWith('.') || specifier.startsWith('file:')) && !/\\.[cm]?[jt]sx?$/.test(specifier)) {
      for (const ext of ['.ts', '.tsx', '/index.ts']) {
        try { return await next(specifier + ext, context); } catch {}
      }
    }
    throw e;
  }
}`;
register('data:text/javascript,' + encodeURIComponent(hook));

type Row = Record<string, unknown>;

async function load<T>(file: string, name: string): Promise<T[]> {
  try {
    const mod = (await import(pathToFileURL(resolve(root, file)).href)) as Record<string, unknown>;
    const list = mod[name];
    if (!Array.isArray(list)) throw new Error(`${file} does not export an array named ${name}`);
    return list as T[];
  } catch (e) {
    console.warn(`! Could not load ${file} (${(e as Error).message}); emitting no rows for it.`);
    return [];
  }
}

const lit = (v: unknown): string => {
  if (v === null || v === undefined) return 'null';
  if (typeof v === 'number') return Number.isFinite(v) ? String(v) : 'null';
  if (typeof v === 'boolean') return v ? 'true' : 'false';
  return `'${String(v).replace(/'/g, "''")}'`;
};
const arr = (v: unknown): string => {
  const list = Array.isArray(v) ? v.map(String) : [];
  return list.length ? `array[${list.map(lit).join(', ')}]::text[]` : `'{}'::text[]`;
};
const json = (v: unknown): string => `${lit(JSON.stringify(v))}::jsonb`;

function upsert(table: string, cols: string[], rows: string[][]): string {
  if (!rows.length) return `-- ${table}: no rows (source data unavailable)\n`;
  const updates = cols.filter((c) => c !== 'id').map((c) => `${c} = excluded.${c}`).join(', ');
  return [
    `insert into public.${table} (${cols.join(', ')}) values`,
    rows.map((r) => `  (${r.join(', ')})`).join(',\n'),
    `on conflict (id) do update set ${updates}, updated_at = now();`,
    `delete from public.${table} where id not in (${rows.map((r) => r[0]).join(', ')});`,
    '',
  ].join('\n');
}

const exercises = await load<Row>('src/data/exercises.ts', 'EXERCISES');
const ingredients = await load<Row>('src/data/ingredients.ts', 'INGREDIENTS');
const recipes = await load<Row>('src/data/recipes.ts', 'RECIPES');

const sql = [
  '-- GENERATED by scripts/gen-reference-seed.mts — do not edit by hand.',
  `-- ${exercises.length} exercises, ${ingredients.length} ingredients, ${recipes.length} recipes.`,
  'begin;',
  upsert('ref_exercises', ['id', 'name', 'category', 'pattern', 'equipment', 'primary_muscles', 'tracking', 'load_convention', 'data'],
    exercises.map((e) => [lit(e.id), lit(e.name), lit(e.category), lit(e.pattern), arr(e.equipment), arr(e.primaryMuscles), lit(e.tracking), lit(e.load), json(e)])),
  upsert('ref_ingredients', ['id', 'name', 'category', 'state', 'allergens', 'data'],
    ingredients.map((i) => [lit(i.id), lit(i.name), lit(i.category), lit(i.state), arr(i.allergens), json(i)])),
  upsert('ref_recipes', ['id', 'name', 'meal', 'servings', 'data'],
    recipes.map((r) => [lit(r.id), lit(r.name), lit(r.meal), lit(r.servings), json(r)])),
  'commit;',
  '',
].join('\n');

const out = resolve(root, 'supabase/seed.sql');
writeFileSync(out, sql);
console.log(`Wrote ${out}: ${exercises.length} exercises, ${ingredients.length} ingredients, ${recipes.length} recipes.`);
